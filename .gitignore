# 환경 설정 (민감 정보)
.env
.env.*
!.env.example

# Laravel vendor
vendor/
node_modules/

# Laravel 생성 파일
bootstrap/cache/*
!bootstrap/cache/.gitkeep
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
!storage/logs/.gitkeep

# 업로드 파일 (사용자 데이터)
uploads/*
!uploads/.gitkeep
upload/*
!upload/.gitkeep

# 날씨 캐시
calendar/weather_cache.json

# 내보내기/캐시 생성 파일
export/*
!export/.gitkeep
tbm/cache/*
!tbm/cache/.gitkeep
tbm/output/*
!tbm/output/.gitkeep

# Claude 메모리 파일
.claude/

# Windows
desktop.ini
Thumbs.db

# VSCode Local History 확장 자동 백업
.history/

# 백업 폴더
tbm/backup_*/
boiler_cleaning/data/backups/

# TBM 로그/디버그 파일
tbm/gemini_raw.txt
tbm/gemini_error.txt
tbm/tbm_ai_debug.log
tbm/php_error.log

# Python / Gradle 캐시
__pycache__/
*.pyc
android-site-app/.gradle/

# 임시 파일 및 DB 저널
tmp/
.tmp-*/
*.db-wal
*.db-shm

