  <script>
    let currentMode = 0; // 0: Live, 1: Demo

    function setMode(mode) {
      currentMode = mode;
      if (mode === 0) {
        document.getElementById('mode-live-btn').className = 'px-3 py-1.5 rounded-lg bg-white text-blue-700 shadow-sm font-semibold transition';
        document.getElementById('mode-demo-btn').className = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition';
      } else {
        document.getElementById('mode-demo-btn').className = 'px-3 py-1.5 rounded-lg bg-white text-blue-700 shadow-sm font-semibold transition';
        document.getElementById('mode-live-btn').className = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition';
      }
      loadTrainings();
      loadStats();
    }

    function switchTab(tabId) {
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('border-blue-600', 'text-blue-600', 'font-semibold');
        btn.classList.add('border-transparent', 'text-slate-500');
      });
      document.getElementById('nav-' + tabId).classList.add('border-blue-600', 'text-blue-600', 'font-semibold');
      document.getElementById('nav-' + tabId).classList.remove('border-transparent', 'text-slate-500');

      document.getElementById('sec-list').classList.toggle('hidden', tabId !== 'list');
      document.getElementById('sec-stats').classList.toggle('hidden', tabId !== 'stats');
      if (tabId === 'stats') { loadPart5Summary(); loadStats(); }
      lucide.createIcons();
    }

    function toggleAllCheckboxes(checked) {
      document.querySelectorAll('.training-row-check').forEach(cb => cb.checked = checked);
    }

    function batchExportSelected() {
      const selected = [];
      document.querySelectorAll('.training-row-check:checked').forEach(cb => selected.push(cb.value));
      if (selected.length === 0) {
        alert('일괄 출력할 교육일지를 1건 이상 체크해 주십시오.');
        return;
      }
      window.location.href = `export.php?batch=${selected.join(',')}`;
    }

    async function syncNewHires() {
      if (!confirm('새로 등록된 신규 입사자 계정을 확인하여 신규채용 교육일지(8시간) 예정기록을 자동 생성하시겠습니까?\n(※ 기존 재직자는 제외되며, 향후 새로 추가되는 신규 입사자에 한해 생성됩니다)')) return;
      const res = await fetch('api.php?action=sync_new_hires');
      const data = await res.json();
      if (data.ok) {
        alert(data.message);
        loadTrainings();
      } else {
        alert('동기화 실패: ' + data.error);
      }
    }

    async function loadTrainings() {
      const csmCode = document.getElementById('filter-csm') ? document.getElementById('filter-csm').value : 'ALL';
      const type = document.getElementById('filter-type').value;
      const status = document.getElementById('filter-status').value;
      const dateFrom = document.getElementById('filter-date-from').value;
      const dateTo = document.getElementById('filter-date-to').value;
      const attendee = document.getElementById('filter-attendee').value;

      const params = new URLSearchParams({
        action: 'list',
        is_demo: currentMode,
        csm_code: csmCode,
        type: type,
        status: status,
        date_from: dateFrom,
        date_to: dateTo,
        attendee: attendee
      });

      const res = await fetch('api.php?' + params.toString());
      const data = await res.json();
      const tbody = document.getElementById('training-tbody');

      if (!data.ok || !data.list || data.list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="12" class="py-8 text-center text-slate-400">등록된 교육일지가 없습니다.</td></tr>';
        return;
      }

      let html = '';
      data.list.forEach(t => {
        const csmBadges = {
          '5.1.1': '<span class="bg-purple-100 text-purple-900 border border-purple-200 px-1.5 py-0.5 rounded text-[10px] font-bold">CSM 5.1.1 (2점)</span>',
          '5.1.2': '<span class="bg-blue-100 text-blue-900 border border-blue-200 px-1.5 py-0.5 rounded text-[10px] font-bold">CSM 5.1.2 (2점)</span>',
          '5.1.3': '<span class="bg-emerald-100 text-emerald-900 border border-emerald-200 px-1.5 py-0.5 rounded text-[10px] font-bold">CSM 5.1.3 (2점)</span>',
          '5.1.4': '<span class="bg-amber-100 text-amber-900 border border-amber-200 px-1.5 py-0.5 rounded text-[10px] font-bold">CSM 5.1.4 (1점)</span>',
          '5.1.5': '<span class="bg-pink-100 text-pink-900 border border-pink-200 px-1.5 py-0.5 rounded text-[10px] font-bold">CSM 5.1.5 (1점)</span>',
          '5.2.2': '<span class="bg-cyan-100 text-cyan-900 border border-cyan-200 px-1.5 py-0.5 rounded text-[10px] font-bold">CSM 5.2.2 (2점)</span>',
          '기타': '<span class="bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded text-[10px]">기타</span>'
        };

        const typeLabels = {
          'REGULAR': '<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded text-[10px] font-semibold">2. 정기안전보건</span>',
          'SPECIAL': `<span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded text-[10px] font-semibold">5. 특별(${t.session_round || 1}회)</span>`,
          'NEW_HIRE': '<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded text-[10px] font-semibold">1. 신규채용시</span>',
          'JOB_CHANGE': '<span class="bg-slate-100 text-slate-800 px-2 py-0.5 rounded text-[10px] font-semibold">3. 작업변경</span>',
          'SUPERVISOR': '<span class="bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded text-[10px] font-semibold">4. 관리감독자</span>',
          'EXTERNAL': '<span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-[10px]">6. 외부강사</span>',
          'OTHER': '<span class="bg-amber-50 text-amber-900 border border-amber-200 px-2 py-0.5 rounded text-[10px]">7. 기타</span>',
          'MSDS': '<span class="bg-purple-100 text-purple-800 px-2 py-0.5 rounded text-[10px] font-semibold">8. MSDS교육</span>',
        };

        const statusBadge = t.status === 'FINALIZED'
          ? '<span class="bg-emerald-600 text-white px-2 py-0.5 rounded text-[10px] font-bold">확정완료 (R' + t.revision_num + ')</span>'
          : '<span class="bg-amber-500 text-white px-2 py-0.5 rounded text-[10px] font-bold">작성중 (DRAFT)</span>';

        const signedBadge = t.scanned_doc_filename 
          ? `<a href="secure_file.php?type=scan&file=${encodeURIComponent(t.scanned_doc_filename)}" target="_blank" class="text-emerald-600 font-bold hover:underline" title="교육일지 자필 서명본 열람">등록됨</a>`
          : '<span class="text-slate-300">-</span>';

        const certBadge = t.cert_doc_filename 
          ? `<a href="secure_file.php?type=scan&file=${encodeURIComponent(t.cert_doc_filename)}" target="_blank" class="text-blue-600 font-bold hover:underline" title="공식 교육이수증(수료증) 열람">이수증</a>`
          : '<span class="text-slate-300">-</span>';

        html += `
          <tr class="hover:bg-slate-50 transition">
            <td class="py-3 px-3 text-center">
              <input type="checkbox" value="${t.id}" class="training-row-check rounded border-slate-300">
            </td>
            <td class="py-3 px-3 text-center font-mono font-bold text-slate-700">${t.training_no}</td>
            <td class="py-3 px-3 text-center font-medium">${t.training_date}</td>
            <td class="py-3 px-3 text-center space-y-1">
              <div>${typeLabels[t.training_type] || t.training_type}</div>
              ${csmBadges[t.csm_item_code] ? '<div>' + csmBadges[t.csm_item_code] + '</div>' : ''}
            </td>
            <td class="py-3 px-4">
              <a href="view.php?id=${t.id}" class="font-bold text-slate-900 hover:text-blue-600 block line-clamp-1">${t.subject}</a>
              <div class="text-[11px] text-slate-500 line-clamp-1 mt-0.5">${t.content_summary}</div>
            </td>
            <td class="py-3 px-2 text-center font-bold text-blue-600">${t.planned_hours}h</td>
            <td class="py-3 px-3 text-center">${t.instructor_name}</td>
            <td class="py-3 px-3 text-center font-mono font-semibold">${t.completed_attendees}/${t.total_attendees}</td>
            <td class="py-3 px-2 text-center">${t.photo_count > 0 ? '<span class="text-purple-600 font-bold">' + t.photo_count + '</span>' : '<span class="text-slate-300">미등록</span>'}</td>
            <td class="py-3 px-2 text-center">${signedBadge}</td>
            <td class="py-3 px-2 text-center">${certBadge}</td>
            <td class="py-3 px-3 text-center">${statusBadge}</td>
            <td class="py-3 px-4 text-center">
              <div class="flex items-center justify-center space-x-1.5">
                <a href="view.php?id=${t.id}" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-semibold">보기</a>
                <a href="print.php?id=${t.id}&print=1" target="_blank" class="px-2 py-1 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded text-[11px] font-semibold flex items-center space-x-0.5" title="회사 양식 바로 인쇄">
                  <i data-lucide="printer" class="w-3 h-3"></i><span>인쇄</span>
                </a>
                <a href="write.php?id=${t.id}" class="px-2 py-1 bg-slate-100 hover:bg-blue-50 text-blue-700 rounded text-[11px] font-semibold">수정</a>
                <a href="export.php?id=${t.id}&format=xlsx" class="px-2 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 rounded text-[11px] font-semibold flex items-center space-x-0.5">
                  <i data-lucide="file-spreadsheet" class="w-3 h-3"></i><span>엑셀</span>
                </a>
                <a href="export.php?id=${t.id}&format=pdf" class="px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-800 rounded text-[11px] font-semibold flex items-center space-x-0.5" title="A4 양면 2페이지 (일지+사진대지)">
                  <i data-lucide="file-down" class="w-3 h-3"></i><span>PDF</span>
                </a>
              </div>
            </td>
          </tr>
        `;
      });

      tbody.innerHTML = html;
      lucide.createIcons();
    }

    
    async function loadPart5Summary() {
      const year = document.getElementById('stats-year') ? document.getElementById('stats-year').value : 2026;
      try {
        const res = await fetch(`api.php?action=csm_part5_summary&year=${year}&is_demo=${currentMode}`);
        const data = await res.json();
        if (!data.ok) return;

        const scoreBadge = document.getElementById('csm-total-score-badge');
        if (scoreBadge) {
          scoreBadge.innerHTML = `<span class="${data.is_perfect ? 'text-emerald-400' : 'text-amber-400'} font-black">${data.total_score.toFixed(1)} / ${data.max_score.toFixed(1)}점</span>`;
        }

        const grid = document.getElementById('csm-items-grid');
        if (!grid) return;

        let html = '';
        Object.values(data.items).forEach(item => {
          const isFull = item.score >= item.points;
          const badgeColor = isFull ? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40' : 'bg-amber-500/20 text-amber-300 border-amber-500/40';
          const statusText = isFull ? '충족 (만점)' : '보완필요';
          
          html += `
            <div class="bg-white/10 hover:bg-white/15 transition border border-white/15 rounded-xl p-4 flex flex-col justify-between space-y-3">
              <div>
                <div class="flex items-center justify-between">
                  <span class="px-2 py-0.5 rounded text-[10px] font-extrabold border ${badgeColor}">
                    CSM ${item.code} &bull; ${statusText}
                  </span>
                  <span class="text-sm font-black ${isFull ? 'text-emerald-400' : 'text-amber-400'}">${item.score.toFixed(1)} / ${item.points.toFixed(1)}점</span>
                </div>
                <h3 class="text-xs font-bold text-white mt-2">${item.name}</h3>
                <p class="text-[11px] text-blue-200 mt-1 leading-relaxed">${item.details}</p>
              </div>
              <div class="pt-2 border-t border-white/10 flex items-center justify-between text-[11px]">
                <span class="text-slate-400 truncate max-w-[160px]" title="${item.files.join(', ')}">증빙: ${item.files[0]}</span>
                <button onclick="filterByCsmItem('${item.code}')" class="px-2 py-1 bg-blue-600/80 hover:bg-blue-600 text-white rounded text-[10px] font-bold">목록 보기 &rarr;</button>
              </div>
            </div>
          `;
        });
        grid.innerHTML = html;
        lucide.createIcons();
      } catch (e) {
        console.error('Error loading CSM Part 5 summary:', e);
      }
    }

    function filterByCsmItem(code) {
      switchTab('list');
      const sel = document.getElementById('filter-csm');
      if (sel) {
        sel.value = code;
        loadTrainings();
      }
    }

    async function loadStats() {
      const year = document.getElementById('stats-year').value;
      const res = await fetch(`api.php?action=stats&year=${year}&is_demo=${currentMode}`);
      const data = await res.json();
      const tbody = document.getElementById('stats-tbody');

      if (!data.ok || !data.stats) return;

      let html = '';
      data.stats.forEach(s => {
        const isRetired = s.status === 'retired';
        const retBadge = isRetired ? '<span class="bg-slate-200 text-slate-600 text-[10px] px-1 rounded">퇴사</span>' : '<span class="bg-emerald-100 text-emerald-700 text-[10px] px-1 rounded">재직</span>';

        const spBadge = s.special_satisfied 
          ? '<span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-1.5 py-0.5 rounded">8h 충족</span>'
          : `<span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-1.5 py-0.5 rounded">${s.special_total}h / 8h</span>`;

        // Format other courses (1h each)
        let otherStr = '-';
        if (s.other_courses && Object.keys(s.other_courses).length > 0) {
          otherStr = Object.entries(s.other_courses).map(([k, v]) => `${k}:${v}h`).join(', ');
        }

        html += `
          <tr class="hover:bg-slate-50">
            <td class="py-2.5 px-3 font-mono text-slate-500">${s.employee_no}</td>
            <td class="py-2.5 px-3 font-bold text-slate-900">${s.name}</td>
            <td class="py-2.5 px-3 text-slate-600">${s.team || '-'}</td>
            <td class="py-2.5 px-3 text-slate-600">${s.position || '-'}</td>
            <td class="py-2.5 px-2 text-center">${retBadge}</td>
            <td class="py-2.5 px-3 text-center font-mono font-bold ${s.regular_h1 > 0 ? 'text-blue-600' : 'text-slate-400'}">${s.regular_h1.toFixed(1)}h</td>
            <td class="py-2.5 px-3 text-center font-mono font-bold ${s.regular_h2 > 0 ? 'text-blue-600' : 'text-slate-400'}">${s.regular_h2.toFixed(1)}h</td>
            <td class="py-2.5 px-3 text-center">${spBadge}</td>
            <td class="py-2.5 px-3 text-center font-mono font-bold ${s.msds_total > 0 ? 'text-purple-600' : 'text-slate-400'}">${s.msds_total.toFixed(1)}h</td>
            <td class="py-2.5 px-3 text-center text-[10px] text-slate-600">${otherStr}</td>
            <td class="py-2.5 px-3 text-center font-mono font-extrabold text-slate-900">${s.total_hours.toFixed(1)}h</td>
          </tr>
        `;
      });
      tbody.innerHTML = html;
    }

    async function triggerBackup() {
      if (!confirm('현재 교육 DB와 첨부된 모든 사진/서명/스캔 파일을 단일 ZIP으로 백업하시겠습니까?')) return;
      const res = await fetch('api.php?action=backup');
      const data = await res.json();
      if (data.ok) {
        alert('백업이 생성되었습니다: ' + data.filename + ' (' + (data.size/1024).toFixed(1) + ' KB)');
        window.location.href = data.download_url;
      } else {
        alert('백업 실패: ' + data.error);
      }
    }

    // Init
    loadTrainings();
    loadStats();
    loadPart5Summary();
    lucide.createIcons();
  </script>
</body>
</html>
